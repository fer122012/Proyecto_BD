# Normalizar saltos de línea
* text=auto

# Archivos de texto con LF
*.sql        text eol=lf
*.java       text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.md         text eol=lf
*.properties text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.sh         text eol=lf

# Scripts de Windows con CRLF
*.bat        text eol=crlf
*.cmd        text eol=crlf
